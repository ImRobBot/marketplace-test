{
  "info": {
    "_postman_id": "6afbd4d6-2e1d-4f34-9a5f-mercadouno0003",
    "name": "Mercado Uno API",
    "description": "Colección para el contrato 0.2.0. Postman conserva automáticamente la cookie HttpOnly creada por registro/login. El soporte Bearer queda solo para compatibilidad explícita.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health & Products",
      "item": [
        {
          "name": "Estado",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/health" }
        },
        {
          "name": "Listar productos",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/products" }
        },
        {
          "name": "Obtener producto",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/products/{{productId}}" }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Iniciar sesión",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Sesión actual",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/auth/me" }
        },
        {
          "name": "Cerrar sesión",
          "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/api/auth/logout" }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Consultar carrito",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/cart" }
        },
        {
          "name": "Añadir producto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"productId\": {{productId}},\n  \"qty\": 1\n}" },
            "url": "{{baseUrl}}/api/cart"
          }
        },
        {
          "name": "Reemplazar cantidad",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"productId\": {{productId}},\n  \"qty\": 2\n}" },
            "url": "{{baseUrl}}/api/cart"
          }
        },
        {
          "name": "Eliminar producto",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/cart/{{productId}}" }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Crear checkout pendiente",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const body = pm.response.json();",
              "if (body.order && body.order.id) pm.environment.set('orderId', body.order.id);"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Idempotency-Key", "value": "postman-{{$guid}}" }],
            "url": "{{baseUrl}}/api/checkout"
          }
        },
        {
          "name": "Listar pedidos propios",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/orders" }
        },
        {
          "name": "Detalle del pedido",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/orders/{{orderId}}" }
        },
        {
          "name": "Pagar con proveedor simulado",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"outcome\": \"paid\"\n}" },
            "url": "{{baseUrl}}/api/orders/{{orderId}}/pay"
          }
        },
        {
          "name": "Cancelar pedido",
          "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/api/orders/{{orderId}}/cancel" }
        }
      ]
    }
  ]
}
