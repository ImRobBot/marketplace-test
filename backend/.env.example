NODE_ENV=development
PORT=4000
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://marketplace:local-marketplace-password@localhost:5432/marketplace
DATABASE_SSL=false
ENABLE_SIMULATED_PAYMENTS=true
TRUST_PROXY=0
# Solo para la importacion; el archivo se abre en modo de solo lectura.
SQLITE_SOURCE=data/database.sqlite
